{
  "name": "actionproof",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "playwright test",
    "benchmark": "npm run build && node scripts/run-benchmark.mjs",
    "audit:production": "node scripts/audit-production.mjs",
    "demo:record": "npm run build && powershell -ExecutionPolicy Bypass -File scripts/generate-narration.ps1 && node scripts/record-demo.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "ffmpeg-static": "^5.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "webmcp-evals": "^0.0.3"
  }
}
