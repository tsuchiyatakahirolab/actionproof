{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "package-dist/types"
  },
  "include": [
    "src/exactdelta.ts",
    "src/core/types.ts",
    "src/core/effect-contract.ts",
    "src/core/gate.ts",
    "src/core/regression.ts",
    "src/core/scenario.ts"
  ]
}
